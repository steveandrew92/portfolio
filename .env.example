APP_NAME="Stevent Andrean Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Lokal
# APP_URL=http://127.0.0.1:8000
# Production di ROOT domain (tanpa /portfolio di URL):
APP_URL=https://steventandrean.id
ASSET_URL="${APP_URL}"

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Portfolio tidak memakai database — gunakan file driver
DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
